# Factory PC settings for start-gateway.cmd (no secrets here)
# Copy to gateway.local.env and edit.

MG_GATEWAY_MODE=simulator
MG_API_BASE_URL=https://api.loopcstrategies.com
MG_XRF_MODE=disabled
MG_GATEWAY_ID=MG-GATEWAY-001
MG_GATEWAY_PORT=7077
MG_GATEWAY_BIND=127.0.0.1

# Optional local management token (required if MG_GATEWAY_BIND=0.0.0.0)
# MG_GATEWAY_LOCAL_TOKEN=change-me

# Dev-only JWT fallback (never for production):
# MG_GATEWAY_ALLOW_JWT_FALLBACK=1

# Modes:
#   simulator  — fake scales (dev / no hardware)
#   RS232      — real MH-708 COM ports (configure config/default.json first)
#
# Dynamic scale count (simulator only, no code change):
#   MG_GATEWAY_SIM_SCALE_COUNT=43
#
# Auth (preferred):
#   Put the shared secret in gateway-secret.txt (gitignored).
#   Backend Railway env must include matching:
#     MG_GATEWAY_SECRETS=MG-GATEWAY-001=<same-secret>
#
# XRF:
#   disabled   — recommended until LANScientific protocol is confirmed
#   simulator  — development only; results tagged source=simulated
